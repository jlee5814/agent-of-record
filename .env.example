# Where SGLang listens. The app talks to its OpenAI compatible API.
SGLANG_BASE_URL=http://localhost:30000/v1
# auto asks the server which model it serves.
MODEL=auto
# sglang or offline
LLM_PROVIDER=sglang
# freight, clinic, or portfolio
DOMAIN=freight
# json_schema, json_object, or prompt. Leave empty to try each and keep the first that works.
EXTRACT_MODE=
# Set to 1 to let Qwen3 think before each reply. Extraction never thinks.
QWEN_THINKING=0
# Demo clock. The fixtures assume 2026-03-10. Use real for the wall clock.
DEMO_TODAY=2026-03-10
